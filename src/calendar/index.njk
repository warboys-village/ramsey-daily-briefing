---
layout: layouts/base.njk
title: "Ramsey Community Events Calendar"
description: "Community events calendar for Ramsey, Cambridgeshire. Discover upcoming town gatherings, library sessions, and council meetings."
permalink: "/calendar/index.html"
---

<div class="page-header" style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1rem;">
  <div>
    <h1 class="page-title">{{ village.villageName }} Community Events Calendar</h1>
    <p class="page-subtitle">Full schedule of upcoming village events, library sessions, council meetings, and community gatherings.</p>
  </div>
  <div>
    <a href="/events.ics" class="button-link" style="padding: 0.5rem 1rem; font-size: 0.9rem; font-weight: 700;">📅 <span class="btn-ical-full-text">Subscribe to calendar</span><span class="btn-ical-mobile-text">Subscribe</span> &rarr;</a>
  </div>
</div>

<!-- Interactive Month Calendar Top Widget -->
<div class="briefing-block" style="margin-bottom: 2rem;">
  <div class="briefing-block-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap;">
    <h3 class="briefing-block-title" id="cal-month-year">August 2026</h3>
    <div class="cal-nav-buttons">
      <button type="button" id="btn-prev-month" class="button-link">&larr; Previous Month</button>
      <button type="button" id="btn-today-month" class="button-link" style="margin: 0 0.35rem;">Today</button>
      <button type="button" id="btn-next-month" class="button-link">Next Month &rarr;</button>
    </div>
  </div>
  <div class="briefing-block-content" style="padding: 1rem;">
    <div class="calendar-grid-header">
      <div>Mon</div><div>Tue</div><div>Wed</div><div>Thu</div><div>Fri</div><div>Sat</div><div>Sun</div>
    </div>
    <div id="calendar-days-grid" class="calendar-grid-days">
      <!-- Generated via client-side script -->
    </div>
    <div class="calendar-legend">
      <span><span class="legend-dot legend-today"></span> Today</span>
      <span><span class="legend-dot legend-events"></span> One-Off Event Date (Click cell to view)</span>
      <span><span class="legend-badge-regular">Regular</span> Regular Session (Click badge to view)</span>
    </div>
  </div>
</div>

<!-- SECTION 1: Scheduled One-Off Community Events -->
<div class="briefing-block" style="margin-bottom: 2rem;">
  <div class="briefing-block-header">
    <h3 class="briefing-block-title">Scheduled One-Off Events</h3>
  </div>
  <div class="briefing-block-content">
    {% set hasOneOff = false %}
    <div class="events-schedule-list">
      {% set renderedKeys = [] %}
      {% for item in events_calendar %}
        {% if not item.isRegular %}
          {% set itemIsoDate = (item.eventDate | default(item.date)) | isoDate %}
          {% set dedupeKey = item.title + "_" + itemIsoDate %}
          {% if dedupeKey not in renderedKeys %}
            {% set renderedKeys = (renderedKeys.push(dedupeKey), renderedKeys) %}
            {% set hasOneOff = true %}
            <div class="event-card" id="events-date-{{ itemIsoDate }}">
              <div class="event-header">
                <h5 class="event-title">{{ item.title }}</h5>
                <div>
                  <span class="badge-status badge-upcoming">
                    {{ item.eventTime | default(itemIsoDate) }}
                  </span>
                </div>
              </div>
              <div class="event-meta">📍 {{ item.venue | default(village.villageName + " Location") }}</div>
              <p class="event-desc">{{ item.content }}</p>
              <div class="card-strapline">
                <div class="strapline-left">
                  <span class="strapline-source">Source: <a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.sourceName }}</a></span>
                  <span class="strapline-sep">•</span>
                  <a href="{{ item.url }}" target="_blank" rel="noopener" class="strapline-report-link">Full Event Details &rarr;</a>
                </div>
              </div>
            </div>
          {% endif %}
        {% endif %}
      {% endfor %}
    </div>
    {% if not hasOneOff %}
      <p style="color: var(--color-text-muted);">No upcoming one-off community events currently scheduled.</p>
    {% endif %}
  </div>
</div>

<!-- SECTION 2: Regular Recurring Groups & Sessions -->
<div class="briefing-block" id="regular-events-panel">
  <div class="briefing-block-header">
    <h3 class="briefing-block-title">Regular Recurring Sessions & Groups</h3>
  </div>
  <div class="briefing-block-content">
    {% set seenRegularTitles = [] %}
    <div class="events-schedule-list">
      {% for item in events_calendar %}
        {% if item.isRegular and item.title not in seenRegularTitles %}
          {% set seenRegularTitles = (seenRegularTitles.push(item.title), seenRegularTitles) %}
          <div class="event-card" id="regular-card-{{ item.id }}">
            <div class="event-header">
              <h5 class="event-title">{{ item.title }}</h5>
              <div>
                <span class="badge-status badge-upcoming">{{ item.eventTime }}</span>
              </div>
            </div>
            <div class="event-meta">📍 {{ item.venue | default(village.villageName + " Library, Great Whyte") }}</div>
            <p class="event-desc">{{ item.content }}</p>
            <div class="card-strapline">
              <div class="strapline-left">
                <span class="strapline-source">Source: <a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.sourceName }}</a></span>
                <span class="strapline-sep">•</span>
                <a href="{{ item.url }}" target="_blank" rel="noopener" class="strapline-report-link">Full Session Details &rarr;</a>
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

<!-- Pass Calendar Events JSON to Client Script -->
<script>
  window.VILLAGE_EVENTS_DATA = {{ events_calendar | dump | safe }};
</script>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const events = window.VILLAGE_EVENTS_DATA || [];
  const daysGrid = document.getElementById('calendar-days-grid');
  const monthYearLabel = document.getElementById('cal-month-year');
  const btnPrev = document.getElementById('btn-prev-month');
  const btnNext = document.getElementById('btn-next-month');
  const btnToday = document.getElementById('btn-today-month');

  let currentDate = new Date();

  // Helper: format YYYY-MM-DD string without timezone shifting
  const formatLocalDateStr = (year, monthIndex, dayNum) => {
    const y = year;
    const m = String(monthIndex + 1).padStart(2, '0');
    const d = String(dayNum).padStart(2, '0');
    return `${y}-${m}-${d}`;
  };

  const renderCalendar = () => {
    const year = currentDate.getFullYear();
    const month = currentDate.getMonth();

    // Calculate Monday-based start index (0 = Mon, 1 = Tue, ..., 6 = Sun)
    const firstDayIndex = (new Date(year, month, 1).getDay() + 6) % 7;
    const totalDaysInMonth = new Date(year, month + 1, 0).getDate();

    const now = new Date();
    const todayIso = formatLocalDateStr(now.getFullYear(), now.getMonth(), now.getDate());

    const monthNames = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
    monthYearLabel.textContent = `${monthNames[month]} ${year}`;

    daysGrid.innerHTML = '';

    // Lead-in empty cells
    for (let i = 0; i < firstDayIndex; i++) {
      const emptyDiv = document.createElement('div');
      emptyDiv.className = 'cal-day-cell cal-day-empty';
      daysGrid.appendChild(emptyDiv);
    }

    // Day cells
    for (let day = 1; day <= totalDaysInMonth; day++) {
      const dayIso = formatLocalDateStr(year, month, day);
      const dayDate = new Date(year, month, day);
      const dayOfWeek = dayDate.getDay(); // 0 = Sun, 1 = Mon, ..., 6 = Sat

      const dayCell = document.createElement('div');
      dayCell.className = 'cal-day-cell';

      const isToday = dayIso === todayIso;
      if (isToday) dayCell.classList.add('cal-day-today');

      // Separate one-off and regular events for this day
      const oneOffEvents = events.filter(e => !e.isRegular && (e.eventDate || e.date || '').slice(0, 10) === dayIso);
      const regularEvents = events.filter(e => e.isRegular && (e.eventDate || e.date || '').slice(0, 10) === dayIso);

      // Highlight cell ONLY if there are one-off events
      if (oneOffEvents.length > 0) {
        dayCell.classList.add('cal-day-has-events');
        dayCell.title = `${oneOffEvents.length} one-off event(s) on ${dayIso}. Click to scroll down.`;
        dayCell.addEventListener('click', (evt) => {
          // If clicked directly on regular badge, don't trigger cell handler
          if (evt.target.classList.contains('cal-badge-regular')) return;
          const targetEl = document.getElementById(`events-date-${dayIso}`);
          if (targetEl) {
            targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
            targetEl.classList.add('event-card-today');
            setTimeout(() => {
              if (!isToday) targetEl.classList.remove('event-card-today');
            }, 2500);
          }
        });
      }

      dayCell.innerHTML = `<span class="cal-day-number">${day}</span>`;

      // Dot for one-off events
      if (oneOffEvents.length > 0) {
        const dot = document.createElement('span');
        dot.className = 'cal-event-dot';
        dayCell.appendChild(dot);
      }

      // Small clickable badge for regular recurring events (without highlighting date cell background)
      if (regularEvents.length > 0) {
        const regBadge = document.createElement('span');
        regBadge.className = 'cal-badge-regular';
        regBadge.textContent = 'Regular';
        regBadge.title = `Regular Session: ${regularEvents[0].title}. Click to view session details.`;
        regBadge.addEventListener('click', (e) => {
          e.stopPropagation(); // Don't trigger cell click
          const targetCard = document.getElementById(`regular-card-${regularEvents[0].id}`) || document.getElementById('regular-events-panel');
          if (targetCard) {
            targetCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
            targetCard.classList.add('event-card-today');
            setTimeout(() => {
              targetCard.classList.remove('event-card-today');
            }, 2500);
          }
        });
        dayCell.appendChild(regBadge);
      }

      daysGrid.appendChild(dayCell);
    }
  };

  btnPrev.addEventListener('click', () => {
    currentDate.setMonth(currentDate.getMonth() - 1);
    renderCalendar();
  });

  btnNext.addEventListener('click', () => {
    currentDate.setMonth(currentDate.getMonth() + 1);
    renderCalendar();
  });

  btnToday.addEventListener('click', () => {
    currentDate = new Date();
    renderCalendar();
  });

  renderCalendar();
});
</script>
