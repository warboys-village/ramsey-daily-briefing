---
layout: layouts/base.njk
pagination:
  data: dailySources
  size: 1
  alias: dailySource
permalink: "/archive/{{ dailySource.date }}/sources/index.html"
---

<div style="margin-bottom: 2rem;">
  <div style="font-size: 0.85rem; font-weight: 600; text-transform: uppercase; color: var(--color-text-muted);">Data Transparency & Audit</div>
  <h1 style="font-family: var(--font-serif); font-size: 2.2rem; margin-bottom: 0.5rem;">Data Sources Audit – {{ dailySource.date | formatDate }}</h1>
  <p style="color: var(--color-text-muted); font-size: 1.05rem;">Comprehensive breakdown of all raw items, document links, meeting minutes, and planning portal records aggregated for {{ village.villageName }}.</p>
</div>

<div class="briefing-card" style="margin-bottom: 2rem;">
  <h3 style="font-family: var(--font-serif); margin-bottom: 0.75rem;">📊 Data Pipeline Statistics</h3>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-top: 1rem;">
    <div style="background: var(--color-tag-bg); padding: 1rem; border-radius: 6px; text-align: center;">
      <div style="font-size: 1.8rem; font-weight: 700; color: var(--color-primary);">{{ dailySource.rawItemCount or 0 }}</div>
      <div style="font-size: 0.85rem; color: var(--color-text-muted);">Total Raw Items Found</div>
    </div>
    <div style="background: var(--color-tag-bg); padding: 1rem; border-radius: 6px; text-align: center;">
      <div style="font-size: 1.8rem; font-weight: 700; color: #16a34a;">{{ dailySource.processedItemCount or 0 }}</div>
      <div style="font-size: 0.85rem; color: var(--color-text-muted);">High-Signal Items Synthesized</div>
    </div>
    <div style="background: var(--color-tag-bg); padding: 1rem; border-radius: 6px; text-align: center;">
      <div style="font-size: 1.8rem; font-weight: 700; color: #0284c7;">{{ dailySource.sources.length or 0 }}</div>
      <div style="font-size: 0.85rem; color: var(--color-text-muted);">Active Source Extractors</div>
    </div>
  </div>
</div>

<h2 style="font-family: var(--font-serif); font-size: 1.6rem; margin-bottom: 1.25rem;">Active Source Extractors & Target Endpoints</h2>
<ul class="sources-list" style="margin-bottom: 2.5rem;">
  {% for src in dailySource.sources %}
    <li class="source-item" style="display: flex; justify-content: space-between; align-items: center; padding: 1rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 8px; margin-bottom: 0.75rem;">
      <div>
        <div style="font-weight: 700; font-size: 1.1rem; color: var(--color-text-main);">{{ src.name }}</div>
        <div style="font-size: 0.85rem; color: var(--color-text-muted); margin-top: 0.25rem;">
          Type: <code>{{ src.type }}</code> &bull; Source ID: <code>{{ src.id }}</code>
        </div>
        <div style="font-size: 0.85rem; margin-top: 0.35rem;">
          Target URL: <a href="{{ src.url }}" target="_blank" rel="noopener" style="color: var(--color-primary); word-break: break-all;">{{ src.url }}</a>
        </div>
      </div>
      <div>
        <span class="button-link" style="background-color: var(--color-tag-bg); font-weight: 600;">
          {{ src.itemCount }} items extracted ({{ src.status }})
        </span>
      </div>
    </li>
  {% endfor %}
</ul>

<h2 style="font-family: var(--font-serif); font-size: 1.6rem; margin-bottom: 1.25rem;">Detailed Extraction Audit & Document Links</h2>
<p style="color: var(--color-text-muted); margin-bottom: 1.5rem;">Below is the verbose audit trail for every item extracted from source documents, agendas, minutes, and feeds:</p>

<div class="sources-list" style="display: flex; flex-direction: column; gap: 1.25rem;">
  {% set itemsToDisplay = dailySource.rawItems if dailySource.rawItems and dailySource.rawItems.length > 0 else dailySource.items %}
  {% for item in itemsToDisplay %}
    <div class="briefing-card" style="border-left: 4px solid var(--color-primary); padding: 1.25rem;">
      <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 0.5rem;">
        <h4 style="font-size: 1.15rem; font-weight: 700; margin: 0; color: var(--color-text-main);">{{ item.title }}</h4>
        <span class="badge-status badge-other" style="white-space: nowrap;">
          {{ item.date | formatDate if item.date else 'Recent' }}
        </span>
      </div>

      <div style="font-size: 0.85rem; color: var(--color-text-muted); margin-bottom: 0.75rem; display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center;">
        <div><strong>Source:</strong> {{ item.sourceName or 'Local Source' }}</div>
        <div>&bull;</div>
        <div><strong>Category:</strong> <code>{{ item.category or 'General' }}</code></div>
        {% if item.eventDate %}
          <div>&bull;</div>
          <div><strong>Event Date:</strong> <code>{{ item.eventDate }}</code></div>
        {% endif %}
        {% if item.reference %}
          <div>&bull;</div>
          <div><strong>Ref:</strong> <code>{{ item.reference }}</code></div>
        {% endif %}
      </div>

      <div style="font-size: 0.9rem; background: var(--color-tag-bg); padding: 0.85rem 1rem; border-radius: 6px; margin-bottom: 0.75rem; line-height: 1.5;">
        <strong>Extracted Details:</strong> {{ item.content }}
      </div>

      <div style="font-size: 0.85rem; background: rgba(2, 132, 199, 0.08); padding: 0.6rem 0.85rem; border-radius: 6px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
        <div>
          📄 <strong>Direct Document / Source Link:</strong> 
          <a href="{{ item.url }}" target="_blank" rel="noopener" style="color: var(--color-primary); font-weight: 600; text-decoration: underline; word-break: break-all;">{{ item.url }}</a>
        </div>
        <a href="{{ item.url }}" target="_blank" rel="noopener" class="button-link" style="font-size: 0.75rem; padding: 0.35rem 0.65rem;">Open Document &rarr;</a>
      </div>
    </div>
  {% endfor %}
</div>

<nav class="archive-actions" style="margin-top: 2.5rem; display: flex; gap: 1rem;">
  <a href="/archive/{{ dailySource.date }}/" class="button-link">&larr; Read Daily Briefing for {{ dailySource.date }}</a>
  <a href="/archive/" class="button-link">Back to Full Archive</a>
</nav>
