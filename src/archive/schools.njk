---
layout: layouts/base.njk
pagination:
  data: collections.briefings
  size: 1
  alias: briefing
permalink: "/archive/{{ briefing.data.isoDate }}/schools/index.html"
---

<header class="briefing-header">
  <div class="briefing-header-top">
    <a href="/archive/{{ briefing.data.isoDate }}/" class="button-link" style="font-size: 0.8rem; padding: 0.3rem 0.65rem; font-weight: 600; text-decoration: none;">&larr; Back to Briefing for {{ briefing.data.date | formatDate }}</a>
    <span class="briefing-date">{{ briefing.data.date | formatDate }}</span>
  </div>
  <h1 class="briefing-title">🏫 Ramsey Schools Hub & Diary</h1>
  <p class="briefing-subtitle">Archived school announcements, term dates, and calendar notices for Ramsey schools.</p>
</header>

<!-- SCHOOL DIRECTORY 2x2 GRID & MOBILE SELECTOR -->
<div class="schools-grid-wrapper" style="margin-bottom: 2.5rem;">
  <div class="schools-mobile-selector" style="margin-bottom: 1rem;">
    <label for="school-toggle-select-archive" style="font-weight: 700; font-size: 0.9rem; margin-bottom: 0.35rem; display: block; color: var(--color-primary);">
      🏫 Select School Details:
    </label>
    <select id="school-toggle-select-archive" style="width: 100%; padding: 0.65rem; font-size: 0.95rem; font-weight: 600; border-radius: 6px; border: 1px solid var(--color-border); background: var(--color-card-bg); color: var(--color-text-main);">
      <option value="none" selected>Select a School to View Details...</option>
      <option value="all">View All 4 Ramsey Schools</option>
      {% for school in ramsey_schools %}
        <option value="{{ school.id }}">{{ school.name }}</option>
      {% endfor %}
    </select>
  </div>

  <div id="schools-grid-archive" class="schools-2x2-grid">
    {% for school in ramsey_schools %}
      <div class="briefing-card school-card-archive" data-school-id="{{ school.id }}" style="border-left: 4px solid {{ school.badgeColor }}; display: flex; flex-direction: column; justify-content: space-between; height: 100%;">
        <div>
          <h3 style="font-family: var(--font-serif); font-size: 1.25rem; margin-bottom: 0.35rem;">{{ school.name }}</h3>
          <div style="font-size: 0.8rem; font-weight: 600; color: var(--color-primary); margin-bottom: 0.75rem;">{{ school.type }}</div>
          <p style="font-size: 0.9rem; color: var(--color-text-muted); margin-bottom: 1rem; line-height: 1.4;">{{ school.description }}</p>
        </div>
        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: auto; padding-top: 0.75rem; border-top: 1px solid var(--color-border);">
          <a href="{{ school.website }}" target="_blank" rel="noopener" class="button-link" style="font-size: 0.8rem; padding: 0.3rem 0.6rem;">Official Site &rarr;</a>
          <a href="{{ school.lettersUrl }}" target="_blank" rel="noopener" class="button-link" style="font-size: 0.8rem; padding: 0.3rem 0.6rem; background: var(--color-tag-bg);">Newsletters &rarr;</a>
          {% if school.gatehouseUrl %}
            <a href="{{ school.gatehouseUrl }}" target="_blank" rel="noopener" class="button-link" style="font-size: 0.8rem; padding: 0.3rem 0.6rem; background: var(--color-tag-bg);">Sixth Form News &rarr;</a>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</div>

<!-- Ramsey Schools iCalendar Year Group Subscription Modal -->
<div id="schools-ical-modal-archive" class="modal-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.55); z-index: 1000; align-items: center; justify-content: center; backdrop-filter: blur(2px);">
  <div class="modal-content" style="background: var(--color-card-bg); border-radius: 8px; max-width: 500px; width: 90%; padding: 1.5rem; box-shadow: 0 10px 25px rgba(0,0,0,0.25); border: 1px solid var(--color-border); position: relative;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; border-bottom: 1px solid var(--color-border); padding-bottom: 0.75rem;">
      <h3 style="margin: 0; font-family: var(--font-serif); font-size: 1.2rem; color: var(--color-primary);">📅 Subscribe to Ramsey Schools iCalendar</h3>
      <button type="button" id="btn-close-schools-ical-modal-archive" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--color-text-muted); line-height: 1;">&times;</button>
    </div>
    <p style="font-size: 0.9rem; color: var(--color-text-muted); margin-bottom: 1.25rem;">
      Select your child's year group or school to subscribe in Apple Calendar, Google Calendar, or Microsoft Outlook:
    </p>
    <div style="display: flex; flex-direction: column; gap: 0.5rem; max-height: 60vh; overflow-y: auto; padding-right: 0.25rem;">
      {% for yr in ramsey_school_years %}
        <a href="/schools-{{ yr.slug }}.ics" class="button-link" style="display: flex; justify-content: space-between; align-items: center; padding: 0.6rem 1rem; font-size: 0.9rem; text-decoration: none; border: 1px solid var(--color-border); border-radius: 6px; background: var(--color-tag-bg); color: var(--color-text-main);">
          <span><strong>{{ yr.label }}</strong></span>
          <span style="font-size: 0.8rem; font-weight: 600; color: var(--color-primary);">Subscribe &rarr;</span>
        </a>
      {% endfor %}
      <a href="/schools-all.ics" class="button-link" style="display: flex; justify-content: space-between; align-items: center; padding: 0.65rem 1rem; font-size: 0.9rem; text-decoration: none; border: 1px solid var(--color-primary); border-radius: 6px; background: var(--color-primary); color: #ffffff; margin-top: 0.5rem;">
        <span><strong>All Ramsey Schools Combined</strong></span>
        <span style="font-size: 0.8rem; font-weight: 600; color: #ffffff;">Subscribe &rarr;</span>
      </a>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const modal = document.getElementById('schools-ical-modal-archive');
  const btnOpens = document.querySelectorAll('.btn-open-schools-ical-modal-archive');
  const btnClose = document.getElementById('btn-close-schools-ical-modal-archive');

  btnOpens.forEach(btn => {
    btn.addEventListener('click', () => {
      if (modal) modal.style.display = 'flex';
    });
  });

  if (btnClose && modal) {
    btnClose.addEventListener('click', () => {
      modal.style.display = 'none';
    });
  }

  if (modal) {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.style.display = 'none';
    });
  }

  const schoolSelect = document.getElementById('school-toggle-select-archive');
  const cards = document.querySelectorAll('.school-card-archive');

  function updateMobileSchoolVisibility() {
    const isMobile = window.innerWidth <= 640;
    const selected = schoolSelect ? schoolSelect.value : 'none';

    cards.forEach(card => {
      if (isMobile) {
        if (selected === 'none') {
          card.style.display = 'none';
        } else if (selected === 'all' || card.getAttribute('data-school-id') === selected) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      } else {
        card.style.display = 'flex';
      }
    });
  }

  if (schoolSelect) {
    schoolSelect.addEventListener('change', updateMobileSchoolVisibility);
  }
  window.addEventListener('resize', updateMobileSchoolVisibility);
  updateMobileSchoolVisibility();
});
</script>

<!-- DATES FOR YOUR DIARY SECTION -->
<div class="briefing-block" style="margin-bottom: 2.5rem;">
  <div class="briefing-block-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
    <h3 class="briefing-block-title" style="margin-bottom: 0;">Dates for Your Diary (Autumn Term 2026)</h3>
    <button type="button" class="btn-open-schools-ical-modal-archive button-link" style="font-size: 0.8rem; padding: 0.3rem 0.65rem;">📅 <span class="btn-ical-full-text">Subscribe to calendar</span><span class="btn-ical-mobile-text">Subscribe</span> &rarr;</button>
  </div>
  <div class="briefing-block-content" style="padding-top: 1.25rem;">
    <p style="margin-bottom: 1.25rem; color: var(--color-text-muted); font-size: 0.9rem;">
      Key term dates, intake events, and workshops extracted from official Ramsey school newsletters and calendars as of {{ briefing.data.date | formatDate }}.
    </p>

    <div class="diary-events-list">
      {% for school in ramsey_schools %}
        {% for kd in school.keyDates %}
          <div class="news-card" style="border-left: 4px solid {{ school.badgeColor }}; margin-bottom: 1rem;">
            <div class="news-card-header" style="align-items: flex-start;">
              <div>
                <h5 class="news-title" style="color: var(--color-text-main); font-weight: 700; margin-bottom: 0.25rem;">
                  {{ kd.title }}
                </h5>
                <div style="font-size: 0.85rem; color: var(--color-text-muted); font-weight: 600;">
                  🏫 <strong>{{ school.name }}</strong> &bull; 📅 {{ kd.time }}
                </div>
              </div>
              <div style="display: flex; gap: 0.25rem; flex-wrap: wrap;">
                {% for yr in kd.targetYears %}
                  <span class="badge-status badge-other" style="font-size: 0.75rem; padding: 0.15rem 0.45rem;">{{ yr }}</span>
                {% endfor %}
              </div>
            </div>
            <div class="news-summary" style="margin-bottom: 0; margin-top: 0.5rem;">
              <p>{{ kd.details }}</p>
            </div>
          </div>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</div>

<nav class="archive-actions" style="margin-top: 2.5rem; display: flex; gap: 1rem; flex-wrap: wrap;">
  <a href="/archive/{{ briefing.data.isoDate }}/" class="button-link">&larr; Daily Briefing for {{ briefing.data.date | formatDate }}</a>
  <a href="/archive/{{ briefing.data.isoDate }}/sources/" class="button-link">Sources Breakdown &rarr;</a>
  <a href="/archive/" class="button-link">Back to Full Archive</a>
</nav>
